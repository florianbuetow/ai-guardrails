perf-mca: build
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    printf "\033[34m=== llvm-mca Throughput Report (informational) ===\033[0m\n"
    llvm_bin="$(scripts/llvm-bin.sh)"
    build_target="$(scripts/build-target.sh)"
    modules="$(scripts/list-sources.sh src/lib '*.S' 'library modules')"
    mkdir -p build/pp
    while IFS= read -r source; do
        name="$(basename "${source%.S}")"
        xcrun clang -target "$build_target" -x assembler-with-cpp -Iinclude -E "$source" -o "build/pp/$name.s"
        printf "\033[0;36m--- %s ---\033[0m\n" "$name"
        "$llvm_bin/llvm-mca" -mtriple=arm64-apple-macos -mcpu=apple-m1 "build/pp/$name.s"
    done <<<"$modules"
    printf "\033[32m✓ perf-mca completed successfully\033[0m\n"
    echo ""

test: build
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    printf "\033[34m=== Running Tests ===\033[0m\n"
    build_target="$(scripts/build-target.sh)"
    unit_sources="$(scripts/list-sources.sh tests/unit '*.S' 'assembly unit tests')"
    cli_scripts="$(scripts/list-sources.sh tests/cli '*.sh' 'CLI black-box tests')"
    compiled_objects="$(scripts/list-sources.sh build/obj '*.o' 'compiled objects')"
    mkdir -p build/tests
    while IFS= read -r source; do
        name="$(basename "${source%.S}")"
        xcrun clang -target "$build_target" -x assembler-with-cpp -Iinclude \
            -Wall -Werror -Wa,--fatal-warnings -g -c "$source" -o "build/tests/$name.o"
        objects=("build/tests/$name.o")
        while IFS= read -r object; do
            if [ "$(basename "$object")" != "main.o" ]; then
                objects+=("$object")
            fi
        done <<<"$compiled_objects"
        xcrun clang -target "$build_target" "${objects[@]}" -o "build/tests/$name"
        printf "  unit: %s\n" "$name"
        "./build/tests/$name"
    done <<<"$unit_sources"
    while IFS= read -r script; do
        printf "  cli:  %s\n" "$(basename "$script")"
        "./$script" "./build/{{project_name}}"
    done <<<"$cli_scripts"
    printf "\033[32m✓ test completed successfully\033[0m\n"
    echo ""

test-binary: build
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    printf "\033[34m=== Asserting Disassembly ===\033[0m\n"
    llvm_bin="$(scripts/llvm-bin.sh)"
    while IFS= read -r suite; do
        symbol="$(basename "${suite%.filecheck}")"
        object="build/obj/$(sed -n 's/^\/\/ OBJECT: //p' "$suite" | head -1)"
        target_symbol="$(sed -n 's/^\/\/ SYMBOL: //p' "$suite" | head -1)"
        if [ ! -f "$object" ] || [ -z "$target_symbol" ]; then
            printf "\033[31m✗ Error: %s must declare '// OBJECT:' and '// SYMBOL:' headers\033[0m\n" "$suite"
            echo ""
            exit 1
        fi
        printf "  %s (%s)\n" "$symbol" "$target_symbol"
        "$llvm_bin/llvm-objdump" --disassemble-symbols="$target_symbol" "$object" \
            | "$llvm_bin/FileCheck" "$suite"
    done < <(find tests/binary -type f -name '*.filecheck' | sort)
    printf "\033[32m✓ test-binary completed successfully\033[0m\n"
    echo ""

ci:
    #!/usr/bin/env bash
    set -e
    echo ""
    printf "\033[34m=== Running CI Checks ===\033[0m\n"
    echo ""
    just check
    just init
    just code-format
    just code-style
    just code-spell
    just code-shell
    just code-semgrep
    just code-lspchecks
    just code-abi
    just code-architecture
    just code-security
    just code-binary
    just test
    just test-binary
    echo ""
    printf "\033[32m✓ ci completed successfully\033[0m\n"
    echo ""

ci-quiet:
    #!/usr/bin/env bash
    set -e
    printf "\033[34m=== Running CI Checks (Quiet Mode) ===\033[0m\n"
    TMPFILE=$(mktemp)
    trap "rm -f $TMPFILE" EXIT

    for target in check init code-format code-style code-spell code-shell code-semgrep \
        code-lspchecks code-abi code-architecture code-security code-binary test test-binary; do
        just "$target" > "$TMPFILE" 2>&1 || { printf "\033[31m✗ %s failed\033[0m\n" "$target"; cat "$TMPFILE"; exit 1; }
        printf "\033[32m✓ %s passed\033[0m\n" "$target"
    done

    echo ""
    printf "\033[32m✓ ci-quiet completed successfully\033[0m\n"
    echo ""
