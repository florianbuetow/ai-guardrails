# =============================================================================
# Justfile Rules:
# 1. Use printf for colored or formatted output.
# 2. Add an empty @echo "" before and after every command block.
# 3. Keep help ordered by lifecycle, run/build, quality, then tests.
# 4. Composite recipes fail fast.
# 5. Every recipe ends with a clear success or failure status.
# =============================================================================

_default:
    @just help

check:
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    for tool in clang otool nm lipo codesign lldb; do
        if ! xcrun --find "$tool" >/dev/null 2>&1 && ! command -v "$tool" >/dev/null 2>&1; then
            printf "\033[31m✗ Error: %s is not available\033[0m\n" "$tool"
            printf "  Install the Xcode Command Line Tools: xcode-select --install\n"
            echo ""
            exit 1
        fi
        printf "\033[32m✓ %s is installed\033[0m\n" "$tool"
    done
    llvm_bin="$(scripts/llvm-bin.sh)"
    for tool in FileCheck llvm-objdump llvm-readobj llvm-mca; do
        if [ ! -x "$llvm_bin/$tool" ]; then
            printf "\033[31m✗ Error: %s is missing from %s\033[0m\n" "$tool" "$llvm_bin"
            printf "  Install with: brew install llvm\n"
            echo ""
            exit 1
        fi
        printf "\033[32m✓ %s is installed\033[0m\n" "$tool"
    done
    for tool in codespell semgrep shellcheck shfmt; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf "\033[31m✗ Error: %s is not installed\033[0m\n" "$tool"
            printf "  Install with: brew install %s\n" "$tool"
            echo ""
            exit 1
        fi
        printf "\033[32m✓ %s is installed\033[0m\n" "$tool"
    done
    echo ""

help:
    @clear
    @echo ""
    @printf "\033[0;34m=== {{project_name}} ===\033[0m\n"
    @echo ""
    @printf "\033[0;33mSetup & Lifecycle:\033[0m\n"
    @printf "  %-40s %s\n" "init" "Check prerequisites and activate the pre-commit hook"
    @printf "  %-40s %s\n" "destroy" "Remove build output and reports"
    @printf "  %-40s %s\n" "check" "Check prerequisites"
    @printf "  %-40s %s\n" "help" "Show this help message"
    @echo ""
    @printf "\033[0;33mRun & Build:\033[0m\n"
    @printf "  %-40s %s\n" "build" "Assemble and link the executable"
    @printf "  %-40s %s\n" "run <args>" "Run the CLI (e.g. just run sum -)"
    @printf "  %-40s %s\n" "debug <args>" "Run the CLI under lldb"
    @echo ""
    @printf "\033[0;33mCode Quality:\033[0m\n"
    @printf "  %-40s %s\n" "code-format" "Normalize source hygiene in place"
    @printf "  %-40s %s\n" "code-style" "Check source hygiene and ARM64 style policy"
    @printf "  %-40s %s\n" "code-spell" "Check spelling with codespell"
    @printf "  %-40s %s\n" "code-shell" "Check project shell scripts with shfmt + ShellCheck"
    @printf "  %-40s %s\n" "code-semgrep" "Run assembly policy rules with Semgrep"
    @printf "  %-40s %s\n" "code-lspchecks" "Validate sources with the Clang integrated assembler"
    @printf "  %-40s %s\n" "code-abi" "Check ABI macro discipline"
    @printf "  %-40s %s\n" "code-architecture" "Check the object-file import boundary"
    @printf "  %-40s %s\n" "code-security" "Check import, dylib and signature allowlists"
    @printf "  %-40s %s\n" "code-binary" "Check Mach-O structure and platform metadata"
    @echo ""
    @printf "\033[0;33mPerformance (informational):\033[0m\n"
    @printf "  %-40s %s\n" "perf-mca" "Print an llvm-mca throughput report"
    @echo ""
    @printf "\033[0;33mCI & Testing:\033[0m\n"
    @printf "  %-40s %s\n" "test" "Run assembly unit tests and CLI black-box tests"
    @printf "  %-40s %s\n" "test-binary" "Assert disassembly with FileCheck"
    @printf "  %-40s %s\n" "ci" "Run every validation check verbosely"
    @printf "  %-40s %s\n" "ci-quiet" "Run every validation check fail-fast with compact output"
    @echo ""

init: check
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    printf "\033[34m=== Initializing Development Environment ===\033[0m\n"
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        git init -q
    fi
    if [ ! -f ".git/hooks/pre-commit" ]; then
        printf "\033[31m✗ Error: .git/hooks/pre-commit is missing\033[0m\n"
        printf "  Re-apply the template or restore the generated hook.\n"
        echo ""
        exit 1
    fi
    chmod +x .git/hooks/pre-commit
    # Run the helper through bash: init is what restores the executable bit,
    # so the helper cannot be assumed executable yet.
    project_scripts="$(bash scripts/list-sources.sh scripts '*.sh' 'project scripts')"
    cli_tests="$(bash scripts/list-sources.sh tests/cli '*.sh' 'CLI black-box tests')"
    while IFS= read -r file; do
        chmod +x "$file"
    done <<<"$project_scripts"
    while IFS= read -r file; do
        chmod +x "$file"
    done <<<"$cli_tests"
    printf "\033[32m✓ init completed successfully\033[0m\n"
    echo ""

build:
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    printf "\033[34m=== Building {{project_name}} ===\033[0m\n"
    build_target="$(scripts/build-target.sh)"
    if [ ! -f src/main.S ]; then
        printf "\033[31m✗ Error: src/main.S is missing\033[0m\n"
        printf "  The project is incomplete. Re-apply the template.\n"
        echo ""
        exit 1
    fi
    modules="$(scripts/list-sources.sh src/lib '*.S' 'library modules')"
    sources="src/main.S"$'\n'"$modules"
    # Start from an empty object directory. Reusing build/obj would let an
    # object from a deleted source survive into the link, so removing a
    # module would still produce a working binary.
    rm -rf build/obj
    mkdir -p build/obj
    while IFS= read -r source; do
        object="build/obj/$(basename "${source%.S}").o"
        xcrun clang -target "$build_target" -x assembler-with-cpp -Iinclude \
            -Wall -Werror -Wa,--fatal-warnings -g -c "$source" -o "$object"
    done <<<"$sources"
    xcrun clang -target "$build_target" build/obj/*.o -o "build/{{project_name}}"
    printf "\033[32m✓ build completed successfully\033[0m\n"
    echo ""

{% raw %}
run *ARGS: build
    @echo ""
    @printf "\033[34m=== Running CLI ===\033[0m\n"
    @./build/{% endraw %}{{project_name}}{% raw %} {{ARGS}}
    @printf "\033[32m✓ run completed successfully\033[0m\n"
    @echo ""

debug *ARGS: build
    @echo ""
    @printf "\033[34m=== Debugging with lldb ===\033[0m\n"
    @lldb -- ./build/{% endraw %}{{project_name}}{% raw %} {{ARGS}}
    @printf "\033[32m✓ debug session ended\033[0m\n"
    @echo ""
{% endraw %}

destroy:
    @echo ""
    @printf "\033[34m=== Cleaning Generated Artifacts ===\033[0m\n"
    @rm -rf build reports
    @printf "\033[32m✓ destroy completed successfully\033[0m\n"
    @echo ""

code-format:
    @echo ""
    @printf "\033[34m=== Normalizing Source Hygiene ===\033[0m\n"
    @./scripts/format-asm.sh --write
    @printf "\033[32m✓ code-format completed successfully\033[0m\n"
    @echo ""

code-style:
    @echo ""
    @printf "\033[34m=== Checking Source Style ===\033[0m\n"
    @./scripts/format-asm.sh --check
    @./scripts/lint-asm.sh
    @printf "\033[32m✓ code-style completed successfully\033[0m\n"
    @echo ""

code-spell:
    @echo ""
    @printf "\033[34m=== Checking Spelling ===\033[0m\n"
    @codespell src tests include scripts config *.md --ignore-words=config/codespell/ignore.txt
    @printf "\033[32m✓ code-spell completed successfully\033[0m\n"
    @echo ""

{% raw %}
code-shell:
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    printf "\033[34m=== Checking Shell Scripts ===\033[0m\n"
    scripts=()
    while IFS= read -r script; do
        scripts+=("$script")
    done < <(find scripts tests/cli -type f -name '*.sh' | sort)
    if [ "${#scripts[@]}" -eq 0 ]; then
        printf "\033[31m✗ Error: no shell scripts found to check\033[0m\n"
        echo ""
        exit 1
    fi
    shfmt -d -i 4 -ci "${scripts[@]}"
    shellcheck "${scripts[@]}"
    printf "\033[32m✓ code-shell completed successfully\033[0m\n"
    echo ""
{% endraw %}

code-semgrep:
    @echo ""
    @printf "\033[34m=== Running Semgrep Policy Rules ===\033[0m\n"
    @# --disable-nosem: a 'nosemgrep' comment must not silence a rule here.
    @# Without it, the rule that forbids suppression comments is suppressed by
    @# the very comment it exists to catch.
    @semgrep --config config/semgrep/ --error --disable-nosem src tests include scripts
    @printf "\033[32m✓ code-semgrep completed successfully\033[0m\n"
    @echo ""

code-lspchecks:
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    printf "\033[34m=== Validating Sources with the Integrated Assembler ===\033[0m\n"
    # This is Clang's integrated assembler, not ArmLS. -Wa,--fatal-warnings is
    # required: -Werror alone leaves assembler warnings non-fatal.
    build_target="$(scripts/build-target.sh)"
    if [ ! -f src/main.S ]; then
        printf "\033[31m✗ Error: src/main.S is missing\033[0m\n"
        printf "  The project is incomplete. Re-apply the template.\n"
        echo ""
        exit 1
    fi
    sources="src/main.S"$'\n'"$(scripts/list-sources.sh src/lib '*.S' 'library modules')"
    sources="$sources"$'\n'"$(scripts/list-sources.sh tests/unit '*.S' 'assembly unit tests')"
    while IFS= read -r source; do
        xcrun clang -target "$build_target" -x assembler-with-cpp -Iinclude \
            -Wall -Werror -Wa,--fatal-warnings -c "$source" -o /dev/null
    done <<<"$sources"
    printf "\033[32m✓ code-lspchecks completed successfully\033[0m\n"
    echo ""

code-abi:
    @echo ""
    @printf "\033[34m=== Checking ABI Macro Discipline ===\033[0m\n"
    @./scripts/verify-abi.sh
    @printf "\033[32m✓ code-abi completed successfully\033[0m\n"
    @echo ""

