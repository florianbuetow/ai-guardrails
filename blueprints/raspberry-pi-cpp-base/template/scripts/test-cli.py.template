#!/usr/bin/env python3
"""Black-box tests for the generated command-line application."""

from __future__ import annotations

import argparse
import subprocess
import unittest
from pathlib import Path


class CliContractTest(unittest.TestCase):
    binary: Path

    def test_no_arguments_prints_exact_greeting(self) -> None:
        result = subprocess.run(
            [self.binary],
            check=False,
            capture_output=True,
            text=True,
        )

        self.assertEqual(result.returncode, 0)
        self.assertEqual(result.stdout, "Hello, world!\n")
        self.assertEqual(result.stderr, "")

    def test_unexpected_argument_is_usage_error(self) -> None:
        result = subprocess.run(
            [self.binary, "unexpected"],
            check=False,
            capture_output=True,
            text=True,
        )

        self.assertEqual(result.returncode, 2)
        self.assertEqual(result.stdout, "")
        self.assertEqual(
            result.stderr,
            "error: this command does not accept arguments\n",
        )

    def test_output_failure_is_runtime_error(self) -> None:
        with Path("/dev/full").open("w", encoding="utf-8") as output:
            result = subprocess.run(
                [self.binary],
                check=False,
                stdout=output,
                stderr=subprocess.PIPE,
                text=True,
            )

        self.assertEqual(result.returncode, 1)
        self.assertEqual(result.stderr, "error: failed to write output\n")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--binary", required=True, type=Path)
    return parser.parse_args()


if __name__ == "__main__":
    arguments = parse_args()
    if not arguments.binary.is_file():
        raise SystemExit(f"binary does not exist: {arguments.binary}")
    CliContractTest.binary = arguments.binary
    unittest.main(argv=[__file__])
