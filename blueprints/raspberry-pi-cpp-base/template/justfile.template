# Raspberry Pi C++ workflow. No source edits during CI.
_default:
    @just help

help:
    @echo ""
    @printf "\033[34mRaspberry Pi C++ development\033[0m\n"
    @echo ""
    @printf "Setup and containers:\n"
    @printf "  %-25s %s\n" "container-build" "Build the ARM64 development image"
    @printf "  %-25s %s\n" "container-init" "Initialize inside the container"
    @printf "  %-25s %s\n" "container-ci" "Run all checks inside the container"
    @printf "  %-25s %s\n" "container-run" "Run Hello World inside the container"
    @printf "  %-25s %s\n" "container-shell" "Open a development shell"
    @printf "  %-25s %s\n" "container-artifact" "Build and test a clean runtime image"
    @printf "  %-25s %s\n" "check" "Check ARM64 Linux and required tools"
    @printf "  %-25s %s\n" "init" "Initialize the project and pre-commit hook"
    @echo ""
    @printf "Build and run:\n"
    @printf "  %-25s %s\n" "build" "Build the GCC release executable"
    @printf "  %-25s %s\n" "run" "Run the application"
    @printf "  %-25s %s\n" "debug" "Debug the application with GDB"
    @printf "  %-25s %s\n" "destroy" "Remove build output and reports"
    @echo ""
    @printf "Code quality:\n"
    @printf "  %-25s %s\n" "code-format" "Format C++ source"
    @printf "  %-25s %s\n" "code-format-check" "Check C++ formatting without modifying files"
    @printf "  %-25s %s\n" "code-style" "Run clang-tidy including direct include checks"
    @printf "  %-25s %s\n" "code-typecheck" "Run cppcheck"
    @printf "  %-25s %s\n" "code-security" "Run Flawfinder"
    @printf "  %-25s %s\n" "code-semgrep" "Enforce project source policies"
    @printf "  %-25s %s\n" "code-secrets" "Detect secrets with Gitleaks"
    @printf "  %-25s %s\n" "code-shell" "Validate shell scripts with ShellCheck and shfmt"
    @printf "  %-25s %s\n" "code-spell" "Check spelling"
    @printf "  %-25s %s\n" "code-architecture" "Check source inventory and compiler-resolved dependencies"
    @printf "  %-25s %s\n" "code-sanitize" "Run ASan and UBSan tests"
    @printf "  %-25s %s\n" "code-binary" "Verify ARM64 ELF structure and hardening"
    @printf "  %-25s %s\n" "code-memcheck" "Run Valgrind memory checks"
    @echo ""
    @printf "Tests and CI:\n"
    @printf "  %-25s %s\n" "test" "Test GCC and Clang debug and optimized builds"
    @printf "  %-25s %s\n" "test-coverage" "Enforce line, function, and branch coverage"
    @printf "  %-25s %s\n" "test-artifact" "Test the installed release executable"
    @printf "  %-25s %s\n" "ci" "Run every required gate, fail-fast"
    @printf "  %-25s %s\n" "ci-quiet" "Run the same gates with captured output"
    @printf "\033[32m✓ help completed\033[0m\n"
    @echo ""

container-build:
