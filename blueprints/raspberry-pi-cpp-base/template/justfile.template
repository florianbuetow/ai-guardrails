build: check
    @echo ""
    @cmake --preset gcc-release && cmake --build --preset gcc-release && printf "\033[32m✓ build passed\033[0m\n" || { printf "\033[31m✗ build failed\033[0m\n" >&2; exit 1; }
    @echo ""

run: build
    @echo ""
    @./build/gcc-release/{{project_name}} && printf "\033[32m✓ run passed\033[0m\n" || { printf "\033[31m✗ run failed\033[0m\n" >&2; exit 1; }
    @echo ""

debug: test
    @echo ""
    @gdb -- ./build/gcc-debug/{{project_name}} && printf "\033[32m✓ debug passed\033[0m\n" || { printf "\033[31m✗ debug failed\033[0m\n" >&2; exit 1; }
    @echo ""

destroy:
    @echo ""
    @rm -rf build reports && printf "\033[32m✓ destroy passed\033[0m\n" || { printf "\033[31m✗ destroy failed\033[0m\n" >&2; exit 1; }
    @echo ""

ci:
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    just check
    just init
    just code-format-check
    just code-style
    just code-typecheck
    just code-security
    just code-semgrep
    just code-secrets
    just code-shell
    just code-spell
    just code-architecture
    just test
    just code-sanitize
    just test-coverage
    just code-binary
    just test-artifact
    printf "\033[32m✓ ci passed\033[0m\n"
    echo ""

ci-quiet:
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    report=$(mktemp)
    trap 'rm -f "$report"' EXIT
    for step in check init code-format-check code-style code-typecheck code-security code-semgrep code-secrets code-shell code-spell code-architecture test code-sanitize test-coverage code-binary test-artifact; do
        if just "$step" >"$report" 2>&1; then
            printf "\033[32m✓ %s passed\033[0m\n" "$step"
        else
            cat "$report"
            printf "\033[31m✗ %s failed\033[0m\n" "$step" >&2
            exit 1
        fi
    done
    printf "\033[32m✓ ci-quiet passed\033[0m\n"
    echo ""
