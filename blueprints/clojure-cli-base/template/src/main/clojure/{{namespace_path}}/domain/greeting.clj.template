(ns {{namespace_name}}.domain.greeting
  (:require [clojure.string :as str]
            [malli.core :as m]))

(def recipient-schema
  [:and
   :string
   [:fn {:error/message "recipient must not be blank"}
    (fn [value]
      (not (str/blank? value)))]])

(def greeting-schema
  [:map
   [:message
    [:and
     :string
     [:fn {:error/message "message must not be blank"}
      (fn [value]
        (not (str/blank? value)))]]]])

(defn create
  [recipient]
  (when-not (m/validate recipient-schema recipient)
    (throw (ex-info "recipient must not be blank" {:recipient recipient})))
  (let [greeting {:message (str "Hello, " recipient "!")}]
    (when-not (m/validate greeting-schema greeting)
      (throw (ex-info "generated greeting failed its contract" {:greeting greeting})))
    greeting))

(m/=> create [:=> [:cat recipient-schema] greeting-schema])
