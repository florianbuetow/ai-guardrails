{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "complete",
    "findings"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "enum": [
        "correctness",
        "security",
        "performance",
        "architecture",
        "tests"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "file",
          "line",
          "title",
          "scenario",
          "evidence"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
