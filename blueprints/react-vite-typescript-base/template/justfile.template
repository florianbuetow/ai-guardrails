# =============================================================================
# Justfile Rules (follow these when editing justfile):
#
# 1. Use printf (not echo) to print colors — some terminals won't render
#    colors with echo.
#
# 2. Always add an empty `@echo ""` line before and after each target's
#    command block.
#
# 3. Always add new targets to the help section and update it when targets
#    are added, modified or removed.
#
# 4. Target ordering in help (and in this file) matters:
#    - Setup targets first (init, setup, install, etc.)
#    - Start/stop/run targets next
#    - Code generation / data tooling targets next
#    - Checks, linting, and tests next (ordered fastest to slowest)
#    Group related targets together and separate groups with an empty
#    `@echo ""` line in the help output.
#
# 5. Composite targets (e.g. ci) that call multiple sub-targets must fail
#    fast: exit 1 on the first error. Never skip over errors or warnings.
#    Use `set -e` or `&&` chaining to ensure immediate abort with the
#    appropriate error message.
#
# 6. Every target must end with a clear short status message:
#    - On success: green (\033[32m) message confirming completion.
#    - On failure: red (\033[31m) message indicating what failed, then exit 1.
# 7. Targets must be shown in groups separated by empty newlines in the help section.
# =============================================================================

# Default recipe: show available commands
_default:
    @just help

# Check prerequisites
check:
    @echo ""
    @if ! command -v node >/dev/null 2>&1; then \
        printf "\033[31m✗ Error: node is not installed\033[0m\n"; \
        printf "  Install Node.js {{node_version}}+: https://nodejs.org/\n"; \
        printf "  Quick install: brew install node@{{node_version}}\n"; \
        echo ""; \
        exit 1; \
    fi
    @node -e 'const major = Number(process.versions.node.split(".")[0]); if (major < {{node_version}}) { console.error("\x1b[31m✗ Error: Node.js {{node_version}}+ required, found " + process.versions.node + "\x1b[0m"); process.exit(1); }'
    @printf "\033[32m✓ node is installed\033[0m\n"
    @node --version | sed 's/^/  /'
    @if ! command -v npm >/dev/null 2>&1; then \
        printf "\033[31m✗ Error: npm is not installed\033[0m\n"; \
        printf "  npm ships with Node.js: https://nodejs.org/\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[32m✓ npm is installed\033[0m\n"
    @if ! command -v codespell >/dev/null 2>&1; then \
        printf "\033[31m✗ Error: codespell is not installed\033[0m\n"; \
        printf "  Install with: brew install codespell\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[32m✓ codespell is installed\033[0m\n"
    @if ! command -v semgrep >/dev/null 2>&1; then \
        printf "\033[31m✗ Error: semgrep is not installed\033[0m\n"; \
        printf "  Install with: brew install semgrep\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[32m✓ semgrep is installed\033[0m\n"
    @echo ""

# Show help information
help:
    @clear
    @echo ""
    @printf "\033[0;34m=== {{project_name}} ===\033[0m\n"
    @echo ""
    @printf "\033[0;33mSetup & Lifecycle:\033[0m\n"
    @printf "  %-40s %s\n" "init" "Install dependencies and Playwright browser"
    @printf "  %-40s %s\n" "destroy" "Remove build artifacts and dependencies"
    @printf "  %-40s %s\n" "check" "Check prerequisites"
    @printf "  %-40s %s\n" "help" "Show this help message"
    @echo ""
    @printf "\033[0;33mRun & Build:\033[0m\n"
    @printf "  %-40s %s\n" "run" "Start the Vite dev server"
    @printf "  %-40s %s\n" "build" "Type-check and build for production"
    @echo ""
    @printf "\033[0;33mCode Quality:\033[0m\n"
    @printf "  %-40s %s\n" "code-format" "Auto-format code (prettier)"
    @printf "  %-40s %s\n" "code-style" "Check formatting and lint (prettier + eslint)"
    @printf "  %-40s %s\n" "code-spell" "Check spelling (codespell)"
    @printf "  %-40s %s\n" "code-semgrep" "Run custom static analysis (Semgrep)"
    @printf "  %-40s %s\n" "code-lspchecks" "Run strict type checks (tsc)"
    @printf "  %-40s %s\n" "code-security" "Run security lint pass (eslint security plugins)"
    @printf "  %-40s %s\n" "code-deptry" "Check dependency hygiene (knip)"
    @printf "  %-40s %s\n" "code-architecture" "Check import architecture (dependency-cruiser)"
    @printf "  %-40s %s\n" "code-audit" "Scan dependencies for vulnerabilities and outdated versions"
    @echo ""
    @printf "\033[0;33mCI & Testing:\033[0m\n"
    @printf "  %-40s %s\n" "test" "Run unit tests (vitest)"
    @printf "  %-40s %s\n" "test-coverage" "Run tests with coverage ({{coverage_threshold}}%% threshold)"
    @printf "  %-40s %s\n" "test-e2e" "Run Playwright e2e tests against the built app"
    @printf "  %-40s %s\n" "ci" "Run ALL validation checks (verbose)"
    @printf "  %-40s %s\n" "ci-quiet" "Run ALL validation checks (silent, fail-fast)"
    @echo ""

# Install dependencies and the Playwright browser
init: check
    @echo ""
    @printf "\033[34m=== Initializing Development Environment ===\033[0m\n"
    @npm install
    @npx playwright install chromium
    @printf "\033[32m✓ init completed successfully\033[0m\n"
    @echo ""

# Start the Vite dev server
run:
    @echo ""
    @printf "\033[34m=== Starting Dev Server ===\033[0m\n"
    @npm run dev
    @printf "\033[32m✓ run completed successfully\033[0m\n"
    @echo ""

# Type-check and build for production
build:
    @echo ""
    @printf "\033[34m=== Building for Production ===\033[0m\n"
    @npm run build
    @printf "\033[32m✓ build completed successfully\033[0m\n"
    @echo ""

# Remove build artifacts and dependencies
destroy:
    @echo ""
    @printf "\033[34m=== Cleaning Build Artifacts ===\033[0m\n"
    @rm -rf node_modules dist coverage playwright-report test-results .vite
    @printf "\033[32m✓ destroy completed successfully\033[0m\n"
    @echo ""

# Auto-format code with prettier
code-format:
    @echo ""
    @printf "\033[34m=== Formatting Code ===\033[0m\n"
    @npx prettier --log-level warn --write .
    @printf "\033[32m✓ code-format completed successfully\033[0m\n"
    @echo ""

# Check formatting and lint (read-only)
code-style:
    @echo ""
    @printf "\033[34m=== Checking Code Style ===\033[0m\n"
    @npx prettier --log-level warn --check .
    @npx eslint . --max-warnings 0
    @printf "\033[32m✓ code-style completed successfully\033[0m\n"
    @echo ""

# Check spelling in code and documentation
code-spell:
    @echo ""
    @printf "\033[34m=== Checking Spelling ===\033[0m\n"
    @codespell src e2e config scripts index.html *.md --ignore-words=config/codespell/ignore.txt
    @printf "\033[32m✓ code-spell completed successfully\033[0m\n"
    @echo ""

# Run Semgrep static analysis with custom rules
code-semgrep:
    @echo ""
    @printf "\033[34m=== Running Semgrep Static Analysis ===\033[0m\n"
    @semgrep --config config/semgrep/ --error src scripts e2e
    @printf "\033[32m✓ code-semgrep completed successfully\033[0m\n"
    @echo ""

# Run strict type checks (LSP-equivalent: tsc over app, node, and e2e configs)
code-lspchecks:
    @echo ""
    @printf "\033[34m=== Running Type Checks ===\033[0m\n"
    @npx tsc -b
    @npx tsc -p tsconfig.e2e.json
    @printf "\033[32m✓ code-lspchecks completed successfully\033[0m\n"
    @echo ""

# Run the dedicated security lint pass (the bandit/gosec analog)
code-security:
    @echo ""
    @printf "\033[34m=== Running Security Lint Pass ===\033[0m\n"
    @npx eslint --no-config-lookup -c config/eslint/security.config.mjs --max-warnings 0 'src/**/*.{ts,tsx}' 'e2e/**/*.ts'
    @printf "\033[32m✓ code-security completed successfully\033[0m\n"
    @echo ""

# Check dependency hygiene (unused/unlisted dependencies, exports, files)
code-deptry:
    @echo ""
    @printf "\033[34m=== Checking Dependencies ===\033[0m\n"
    @npx knip
    @printf "\033[32m✓ code-deptry completed successfully\033[0m\n"
    @echo ""

# Check import architecture (no cycles, no orphans, no src -> e2e/test imports)
code-architecture:
    @echo ""
    @printf "\033[34m=== Checking Import Architecture ===\033[0m\n"
    @npx depcruise src e2e --config .dependency-cruiser.cjs
    @printf "\033[32m✓ code-architecture completed successfully\033[0m\n"
    @echo ""

# Scan dependencies for vulnerabilities and outdated versions
# Note: npm outdated exits 1 whenever anything is outdated, which conflicts
# with fail-fast. npm-check-updates without -u reports the same information
# and exits 0 cleanly, like Gradle's dependencyUpdates.
code-audit:
    @echo ""
    @printf "\033[34m=== Scanning Dependencies for Vulnerabilities ===\033[0m\n"
    @npm audit --audit-level=high
    @npx --yes npm-check-updates
    @printf "\033[32m✓ code-audit completed successfully\033[0m\n"
    @echo ""

# Run unit tests
test:
    @echo ""
    @printf "\033[34m=== Running Unit Tests ===\033[0m\n"
    @npx vitest run
    @printf "\033[32m✓ test completed successfully\033[0m\n"
    @echo ""

# Run unit tests with coverage report and threshold check
test-coverage:
    @echo ""
    @printf "\033[34m=== Running Unit Tests with Coverage ===\033[0m\n"
    @npx vitest run --coverage
    @printf "\033[32m✓ test-coverage completed successfully\033[0m\n"
    @echo ""

# Run Playwright e2e tests (builds and serves the app via vite preview)
test-e2e:
    @echo ""
    @printf "\033[34m=== Running E2E Tests ===\033[0m\n"
    @npx playwright test
    @printf "\033[32m✓ test-e2e completed successfully\033[0m\n"
    @echo ""

# Run ALL validation checks (verbose)
ci:
    #!/usr/bin/env bash
    set -e
    echo ""
    printf "\033[34m=== Running CI Checks ===\033[0m\n"
    echo ""
    just check
    just init
    just code-format
    just code-style
    just code-spell
    just code-semgrep
    just code-lspchecks
    just code-security
    just code-deptry
    just build
    just test
    just code-architecture
    just test-coverage
    just test-e2e
    just code-audit
    echo ""
    printf "\033[32m✓ ci completed successfully\033[0m\n"
    echo ""

# Run ALL validation checks silently (only show output on errors)
ci-quiet:
    #!/usr/bin/env bash
    set -e
    printf "\033[34m=== Running CI Checks (Quiet Mode) ===\033[0m\n"
    TMPFILE=$(mktemp)
    trap "rm -f $TMPFILE" EXIT

    for target in check init code-format code-style code-spell code-semgrep \
        code-lspchecks code-security code-deptry build test code-architecture \
        test-coverage test-e2e code-audit; do
        just "$target" > "$TMPFILE" 2>&1 || { printf "\033[31m✗ %s failed\033[0m\n" "$target"; cat "$TMPFILE"; exit 1; }
        printf "\033[32m✓ %s passed\033[0m\n" "$target"
    done

    echo ""
    printf "\033[32m✓ ci-quiet completed successfully\033[0m\n"
    echo ""
