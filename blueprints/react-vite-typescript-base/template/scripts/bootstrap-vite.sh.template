#!/usr/bin/env bash

# Runs as a Copier post-generation task with cwd = project root.
# Phase 2 of generation: scaffold the current Vite react-ts app, merge it into
# the project root (template-provisioned files always win), then install the
# guardrail toolchain unpinned so every apply gets current versions.

set -euo pipefail

SCAFFOLD_DIR=".vite-scaffold"
SENTINEL=".bootstrap-complete"

# The sentinel is written as the very last step. Its presence means the full
# bootstrap (scaffold + toolchain install) succeeded — `copier update` re-runs
# tasks, and this makes that a clean no-op instead of a failure.
if [ -f "$SENTINEL" ]; then
    printf "Vite scaffold already applied — nothing to do.\n"
    exit 0
fi

if [ -f "package.json" ]; then
    printf "Error: package.json exists but %s is missing — a previous bootstrap\n" "$SENTINEL" >&2
    printf "failed midway. Delete the generated directory and re-run copier copy.\n" >&2
    exit 1
fi

rm -rf "$SCAFFOLD_DIR"

# Redirect stdin from /dev/null so create-vite is non-interactive even when
# run from a terminal: current create-vite otherwise prompts for a package
# name when a TTY is attached. The real package name is set via `npm pkg set`
# below, so the scaffold's default name is irrelevant.
npm create -y vite@latest "$SCAFFOLD_DIR" -- --template react-ts </dev/null

# Merge rule: copy a scaffold file only where no file already exists.
# Template files (justfile, .oxlintrc.json, README.md, ...) always win.
(cd "$SCAFFOLD_DIR" && find . -type f | sed 's|^\./||') | while IFS= read -r rel_path; do
    if [ ! -f "$rel_path" ]; then
        mkdir -p "$(dirname "$rel_path")"
        cp "$SCAFFOLD_DIR/$rel_path" "$rel_path"
    fi
done

rm -rf "$SCAFFOLD_DIR"

# The scaffold named the package after the staging dir — set real metadata.
npm pkg set name="{{project_name}}" description="{{project_description}}" \
    engines.node=">={{node_version}}"

# Guardrail toolchain — deliberately unpinned (latest at apply time). The Vite
# react-ts scaffold lints with oxlint and no longer ships an ESLint stack, so
# the template owns its linter explicitly: oxlint drives both `code-style` and
# the `code-security` pass via .oxlintrc.json + config/oxlint/security.oxlintrc.json.
npm install --save-dev \
    oxlint \
    prettier \
    vitest \
    @vitest/coverage-v8 \
    jsdom \
    @testing-library/react \
    @testing-library/jest-dom \
    @testing-library/user-event \
    @playwright/test \
    @types/node \
    dependency-cruiser \
    knip

touch "$SENTINEL"

printf "Vite scaffold merged and guardrail toolchain installed.\n"
