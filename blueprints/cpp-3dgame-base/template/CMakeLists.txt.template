cmake_minimum_required(VERSION 3.25)
project({{project_name}} VERSION 0.1.0 LANGUAGES CXX)

# Require LLVM/Clang; fail loudly rather than silently using AppleClang, GCC, or MSVC.
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR
        "Requires LLVM/Clang. Found '${CMAKE_CXX_COMPILER_ID}'. "
        "Install LLVM and point CC/CXX at it (macOS: brew install llvm).")
endif()

# C++ standard
set(CMAKE_CXX_STANDARD {{cpp_standard}})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Export compile_commands.json for clang-tidy, IWYU, etc.
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# Strict compiler warnings for project-owned targets.
option(PROJECT_WARNINGS_AS_ERRORS "Treat project warnings as errors" ON)

function(enable_project_warnings target_name)
    if(MSVC)
        target_compile_options(${target_name} PRIVATE /W4 /permissive-)
        if(PROJECT_WARNINGS_AS_ERRORS)
            target_compile_options(${target_name} PRIVATE /WX)
        endif()
    else()
        target_compile_options(${target_name} PRIVATE
            -Wall -Wextra -Wpedantic
            -Wconversion -Wsign-conversion -Wshadow
            -Wnon-virtual-dtor -Wold-style-cast -Wcast-align
            -Woverloaded-virtual -Wunused
        )
        if(PROJECT_WARNINGS_AS_ERRORS)
            target_compile_options(${target_name} PRIVATE -Werror)
        endif()
    endif()
endfunction()

# Coverage flags (enabled via CMakePresets.json)
option(ENABLE_COVERAGE "Enable code coverage instrumentation" OFF)
if(ENABLE_COVERAGE)
    if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
        message(FATAL_ERROR "Coverage requires Debug build type")
    endif()
    add_compile_options(-O0 -g --coverage -fprofile-arcs -ftest-coverage)
    add_link_options(--coverage -fprofile-arcs -ftest-coverage)
endif()

# Sanitizer flags (enabled via CMakePresets.json)
option(ENABLE_SANITIZERS "Enable AddressSanitizer and UndefinedBehaviorSanitizer" OFF)
if(ENABLE_SANITIZERS)
    if(NOT MSVC)
        add_compile_options(-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
        add_link_options(-fsanitize=address,undefined)
    endif()
endif()

# Main library target (all source except main.cpp)
add_library(${PROJECT_NAME}_lib STATIC
    src/app.cpp
)
target_include_directories(${PROJECT_NAME}_lib PUBLIC
    ${CMAKE_SOURCE_DIR}/include
)
enable_project_warnings(${PROJECT_NAME}_lib)

# Main executable
add_executable(${PROJECT_NAME} src/main.cpp)
target_link_libraries(${PROJECT_NAME} PRIVATE ${PROJECT_NAME}_lib)
enable_project_warnings(${PROJECT_NAME})

# Testing
option(BUILD_TESTING "Build tests" ON)
if(BUILD_TESTING)
    enable_testing()
    find_package(GTest REQUIRED)

    # Core
    find_package(fmt REQUIRED)
    find_package(spdlog REQUIRED)
    find_package(glm REQUIRED)
    find_package(EnTT REQUIRED)
    find_package(Bitsery REQUIRED)
    find_package(xxHash REQUIRED)
    find_package(zstd REQUIRED)
    find_package(SQLite3 REQUIRED)
    find_package(libpqxx REQUIRED)

    # Audio + assets
    find_package(Opus REQUIRED)
    find_package(miniaudio REQUIRED)
    find_package(TinyGLTF REQUIRED)
    find_package(meshoptimizer REQUIRED)
    find_package(Ktx REQUIRED)
    find_package(ozz-animation REQUIRED)
    find_package(mikktspace REQUIRED)

    # Vulkan + shader toolchain (MoltenVK comes from brew, see APPLE block below)
    find_package(VulkanHeaders REQUIRED)
    find_package(VulkanLoader REQUIRED)
    find_package(volk REQUIRED)
    find_package(vk-bootstrap REQUIRED)
    find_package(VulkanMemoryAllocator REQUIRED)
    find_package(shaderc REQUIRED)
    find_package(SPIRV-Tools REQUIRED)
    find_package(spirv-cross REQUIRED)

    # Runtime + UI
    find_package(SDL3 REQUIRED)
    find_package(Jolt REQUIRED)
    find_package(recastnavigation REQUIRED)
    find_package(GameNetworkingSockets REQUIRED)
    find_package(imgui REQUIRED)
    find_package(imguizmo REQUIRED)
    find_package(RmlUi REQUIRED)
    find_package(Tracy REQUIRED)

    # One smoke test per dependency proves it compiles, links, and runs.
    set(DEPS_TEST_SOURCES
        tests/deps/fmt_test.cpp
        tests/deps/spdlog_test.cpp
        tests/deps/glm_test.cpp
        tests/deps/entt_test.cpp
        tests/deps/bitsery_test.cpp
        tests/deps/xxhash_test.cpp
        tests/deps/zstd_test.cpp
        tests/deps/sqlite3_test.cpp
        tests/deps/libpqxx_test.cpp
        tests/deps/opus_test.cpp
        tests/deps/miniaudio_test.cpp
        tests/deps/tinygltf_test.cpp
        tests/deps/meshoptimizer_test.cpp
        tests/deps/ktx_test.cpp
        tests/deps/ozz_animation_test.cpp
        tests/deps/mikktspace_test.cpp
        tests/deps/vulkan_headers_test.cpp
        tests/deps/volk_test.cpp
        tests/deps/vk_bootstrap_test.cpp
        tests/deps/vma_test.cpp
        tests/deps/shaderc_test.cpp
        tests/deps/spirv_tools_test.cpp
        tests/deps/spirv_cross_test.cpp
        tests/deps/sdl_test.cpp
        tests/deps/joltphysics_test.cpp
        tests/deps/recastnavigation_test.cpp
        tests/deps/gamenetworkingsockets_test.cpp
        tests/deps/imgui_test.cpp
        tests/deps/imguizmo_test.cpp
        tests/deps/rmlui_test.cpp
        tests/deps/tracy_test.cpp
    )
    # Jolt 5.2 uses std::is_trivial without including <type_traits>; libc++ 22
    # no longer provides it transitively, so force-include it for that TU.
    set_source_files_properties(tests/deps/joltphysics_test.cpp
        PROPERTIES COMPILE_OPTIONS "-include;type_traits")

    # ImGuizmo.h declares ImGui types but does not include imgui.h itself.
    set_source_files_properties(tests/deps/imguizmo_test.cpp
        PROPERTIES COMPILE_OPTIONS "-include;imgui.h")

    add_executable(${PROJECT_NAME}_tests
        tests/app_test.cpp
        ${DEPS_TEST_SOURCES}
    )
    target_link_libraries(${PROJECT_NAME}_tests PRIVATE
        ${PROJECT_NAME}_lib
        GTest::gtest_main
        fmt::fmt
        spdlog::spdlog
        glm::glm
        EnTT::EnTT
        Bitsery::bitsery
        xxHash::xxhash
        zstd::libzstd_static
        SQLite::SQLite3
        libpqxx::pqxx
        Opus::opus
        miniaudio::miniaudio
        TinyGLTF::TinyGLTF
        meshoptimizer::meshoptimizer
        KTX::ktx
        ozz-animation::ozz-animation
        mikktspace::mikktspace
        vulkan-headers::vulkan-headers
        volk::volk
        vk-bootstrap::vk-bootstrap
        GPUOpen::VulkanMemoryAllocator
        shaderc::shaderc
        spirv-tools::spirv-tools
        spirv-cross::spirv-cross
        SDL3::SDL3
        Jolt::Jolt
        recastnavigation::recastnavigation
        GameNetworkingSockets::GameNetworkingSockets
        imgui::imgui
        imguizmo::imguizmo
        RmlUi::RmlUi
        Tracy::TracyClient
    )
    enable_project_warnings(${PROJECT_NAME}_tests)

    include(GoogleTest)
    gtest_discover_tests(${PROJECT_NAME}_tests)

    # Separate binary: the loader exports real vk* functions that must not
    # coexist with volk's function-pointer globals in one link unit.
    add_executable(${PROJECT_NAME}_vkloader_tests tests/deps/vulkan_loader_test.cpp)
    target_link_libraries(${PROJECT_NAME}_vkloader_tests PRIVATE
        GTest::gtest_main
        Vulkan::Loader
    )
    enable_project_warnings(${PROJECT_NAME}_vkloader_tests)
    gtest_discover_tests(${PROJECT_NAME}_vkloader_tests)

    if(APPLE)
        # MoltenVK is the macOS Vulkan driver; ConanCenter's recipe requires
        # apple-clang, so it is delivered via brew and linked explicitly.
        execute_process(
            COMMAND brew --prefix molten-vk
            OUTPUT_VARIABLE MOLTENVK_PREFIX
            OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE MOLTENVK_PREFIX_RESULT
        )
        if(NOT MOLTENVK_PREFIX_RESULT EQUAL 0)
            message(FATAL_ERROR "MoltenVK not found. Install with: brew install molten-vk")
        endif()
        find_library(MOLTENVK_LIBRARY MoltenVK
            PATHS "${MOLTENVK_PREFIX}/lib" REQUIRED NO_DEFAULT_PATH)
        add_executable(${PROJECT_NAME}_moltenvk_tests tests/deps/moltenvk_test.cpp)
        target_link_libraries(${PROJECT_NAME}_moltenvk_tests PRIVATE
            GTest::gtest_main
            vulkan-headers::vulkan-headers
            ${MOLTENVK_LIBRARY}
        )
        enable_project_warnings(${PROJECT_NAME}_moltenvk_tests)
        gtest_discover_tests(${PROJECT_NAME}_moltenvk_tests)
    endif()
endif()
