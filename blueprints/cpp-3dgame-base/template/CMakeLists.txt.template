cmake_minimum_required(VERSION 3.25)
project({{project_name}} VERSION 0.1.0 LANGUAGES CXX)

# Require LLVM/Clang; fail loudly rather than silently using AppleClang, GCC, or MSVC.
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR
        "Requires LLVM/Clang. Found '${CMAKE_CXX_COMPILER_ID}'. "
        "Install LLVM and point CC/CXX at it (macOS: brew install llvm).")
endif()

# C++ standard
set(CMAKE_CXX_STANDARD {{cpp_standard}})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Export compile_commands.json for clang-tidy, IWYU, etc.
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# Strict compiler warnings for project-owned targets.
option(PROJECT_WARNINGS_AS_ERRORS "Treat project warnings as errors" ON)
option(THIRD_PARTY_WARNINGS_AS_ERRORS "Treat third-party warnings as errors" OFF)

function(enable_project_warnings target_name)
    if(MSVC)
        target_compile_options(${target_name} PRIVATE /W4 /permissive-)
        if(PROJECT_WARNINGS_AS_ERRORS)
            target_compile_options(${target_name} PRIVATE /WX)
        endif()
    else()
        target_compile_options(${target_name} PRIVATE
            -Wall -Wextra -Wpedantic
            -Wconversion -Wsign-conversion -Wshadow
            -Wnon-virtual-dtor -Wold-style-cast -Wcast-align
            -Woverloaded-virtual -Wunused
        )
        if(PROJECT_WARNINGS_AS_ERRORS)
            target_compile_options(${target_name} PRIVATE -Werror)
        endif()
    endif()
endfunction()

# Coverage flags (enabled via CMakePresets.json)
option(ENABLE_COVERAGE "Enable code coverage instrumentation" OFF)
if(ENABLE_COVERAGE)
    if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
        message(FATAL_ERROR "Coverage requires Debug build type")
    endif()
    add_compile_options(-O0 -g --coverage -fprofile-arcs -ftest-coverage)
    add_link_options(--coverage -fprofile-arcs -ftest-coverage)
endif()

# Sanitizer flags (enabled via CMakePresets.json)
option(ENABLE_SANITIZERS "Enable AddressSanitizer and UndefinedBehaviorSanitizer" OFF)
if(ENABLE_SANITIZERS)
    if(NOT MSVC)
        add_compile_options(-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
        add_link_options(-fsanitize=address,undefined)
    endif()
endif()

# Main library target (all source except main.cpp)
add_library(${PROJECT_NAME}_lib STATIC
    src/app.cpp
)
target_include_directories(${PROJECT_NAME}_lib PUBLIC
    ${CMAKE_SOURCE_DIR}/include
)
enable_project_warnings(${PROJECT_NAME}_lib)

# Main executable
add_executable(${PROJECT_NAME} src/main.cpp)
target_link_libraries(${PROJECT_NAME} PRIVATE ${PROJECT_NAME}_lib)
enable_project_warnings(${PROJECT_NAME})

# Testing
option(BUILD_TESTING "Build tests" ON)
if(BUILD_TESTING)
    enable_testing()
    include(FetchContent)
    FetchContent_Declare(
        googletest
        GIT_REPOSITORY https://github.com/google/googletest.git
        GIT_TAG v1.17.0
        SYSTEM
    )
    FetchContent_MakeAvailable(googletest)

    foreach(googletest_target gtest gtest_main gmock gmock_main)
        if(TARGET ${googletest_target})
            if(THIRD_PARTY_WARNINGS_AS_ERRORS)
                if(MSVC)
                    target_compile_options(${googletest_target} PRIVATE /WX)
                else()
                    target_compile_options(${googletest_target} PRIVATE -Werror)
                endif()
            else()
                if(MSVC)
                    target_compile_options(${googletest_target} PRIVATE /w)
                else()
                    target_compile_options(${googletest_target} PRIVATE -w)
                endif()
            endif()
        endif()
    endforeach()

    add_executable(${PROJECT_NAME}_tests
        tests/app_test.cpp
    )
    target_link_libraries(${PROJECT_NAME}_tests PRIVATE
        ${PROJECT_NAME}_lib
        GTest::gtest_main
    )
    enable_project_warnings(${PROJECT_NAME}_tests)

    include(GoogleTest)
    gtest_discover_tests(${PROJECT_NAME}_tests)
endif()
