        printf "\033[0;31m✗ Error: ninja is not installed\033[0m\n"; \
        printf "  Install with: brew install ninja\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ ninja is installed\033[0m\n"
    @if [ "$(uname -s)" = "Darwin" ]; then \
        if ! brew --prefix molten-vk >/dev/null 2>&1 || [ ! -f "$(brew --prefix molten-vk)/lib/libMoltenVK.dylib" ]; then \
            printf "\033[0;31m✗ Error: MoltenVK is not installed\033[0m\n"; \
            printf "  Install with: brew install molten-vk\n"; \
