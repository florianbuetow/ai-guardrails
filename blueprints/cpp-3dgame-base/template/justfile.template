# =============================================================================
# Justfile Rules (follow these when editing justfile):
#
# 1. Use printf (not echo) to print colors — some terminals won't render
#    colors with echo.
#
# 2. Always add an empty `@echo ""` line before and after each target's
#    command block.
#
# 3. Always add new targets to the help section and update it when targets
#    are added, modified or removed.
#
# 4. Target ordering in help (and in this file) matters:
#    - Setup targets first (init, setup, install, etc.)
#    - Start/stop/run targets next
#    - Code generation / data tooling targets next
#    - Checks, linting, and tests next (ordered fastest to slowest)
#    Group related targets together and separate groups with an empty
#    `@echo ""` line in the help output.
#
# 5. Composite targets (e.g. ci) that call multiple sub-targets must fail
#    fast: exit 1 on the first error. Never skip over errors or warnings.
#    Use `set -e` or `&&` chaining to ensure immediate abort with the
#    appropriate error message.
#
# 6. Every target must end with a clear short status message:
#    - On success: green (\033[32m) message confirming completion.
#      E.g. printf "\033[32m✓ init completed successfully\033[0m\n"
#    - On failure: red (\033[31m) message indicating what failed, then exit 1.
#      E.g. printf "\033[31m✗ ci failed: tests exited with errors\033[0m\n"
# 7. Targets must be shown in groups separated by empty newlines in the help section.
#    - init/destroy/clean/help on top, ci and other tests on the bottom, between other groups
# =============================================================================

# Default recipe: show available commands
_default:
    @just help

# Show help information
help:
    @clear
    @echo ""
    @printf "\033[0;34m=== {{project_name}} ===\033[0m\n"
    @echo ""
    @printf "\033[0;33mSetup & Lifecycle:\033[0m\n"
    @printf "  %-40s %s\n" "init" "Initialize the development environment"
    @printf "  %-40s %s\n" "destroy" "Remove build artifacts and caches"
    @printf "  %-40s %s\n" "check" "Check prerequisites"
    @printf "  %-40s %s\n" "help" "Show this help message"
    @echo ""
    @printf "\033[0;33mRun:\033[0m\n"
    @printf "  %-40s %s\n" "run" "Run the main application"
    @printf "  %-40s %s\n" "demo" "Run the Vulkan cube demo (visual stack check)"
    @echo ""
    @printf "\033[0;33mCode Quality:\033[0m\n"
    @printf "  %-40s %s\n" "code-format" "Auto-fix code formatting with clang-format"
    @printf "  %-40s %s\n" "code-style" "Run clang-tidy static analysis"
    @printf "  %-40s %s\n" "code-typecheck" "Run cppcheck static analysis"
    @printf "  %-40s %s\n" "code-security" "Run security checks with flawfinder"
    @printf "  %-40s %s\n" "code-infer" "Run Infer static analysis (null deref, memory leaks)"
    @printf "  %-40s %s\n" "code-deptry" "Check include hygiene with IWYU"
    @printf "  %-40s %s\n" "code-spell" "Check spelling in code and documentation"
    @printf "  %-40s %s\n" "code-semgrep" "Run Semgrep static analysis"
    @printf "  %-40s %s\n" "code-sanitize" "Run tests with sanitizers (ASan + UBSan)"
    @echo ""
    @printf "\033[0;33mCI & Testing:\033[0m\n"
    @printf "  %-40s %s\n" "test" "Run unit tests"
    @printf "  %-40s %s\n" "test-render" "Run headless GPU rendering test"
    @printf "  %-40s %s\n" "test-coverage" "Run tests with coverage report"
    @printf "  %-40s %s\n" "ci" "Run ALL validation checks (verbose)"
    @printf "  %-40s %s\n" "ci-quiet" "Run ALL validation checks silently"
    @echo ""

# Resolve the LLVM/Clang bin directory (rejects AppleClang); print it, or fail.
[private]
_llvm-bin:
    #!/usr/bin/env bash
    case "$(uname -s)" in
        Darwin)
            if command -v brew >/dev/null 2>&1; then
                prefix="$(brew --prefix llvm 2>/dev/null)"
                if [ -n "$prefix" ] && [ -x "$prefix/bin/clang++" ]; then
                    printf '%s\n' "$prefix/bin"
                    exit 0
                fi
            fi
            printf "\033[0;31m✗ Error: LLVM/Clang not found. Install with: brew install llvm\033[0m\n" >&2
            exit 1
            ;;
        *)
            if command -v clang++ >/dev/null 2>&1; then
                dirname "$(command -v clang++)"
                exit 0
            fi
            printf "\033[0;31m✗ Error: LLVM/Clang (clang++) not found on PATH\033[0m\n" >&2
            exit 1
            ;;
    esac

# Install the gltfpack CLI (glTF optimizer from the meshoptimizer project).
# Pinned to the same version as the Conan meshoptimizer dependency so that
# gltfpack output stays decodable by the runtime library.
[private]
_install-gltfpack:
    #!/usr/bin/env bash
    set -euo pipefail
    GLTFPACK_VERSION="1.0"
    INSTALL_DIR="$HOME/.local/bin"
    if command -v gltfpack >/dev/null 2>&1; then
        printf "\033[0;32m✓ gltfpack is installed (%s)\033[0m\n" "$(command -v gltfpack)"
        exit 0
    fi
    if [ -x "$INSTALL_DIR/gltfpack" ] || [ -x "$INSTALL_DIR/gltfpack.exe" ]; then
        printf "\033[0;32m✓ gltfpack is installed in %s\033[0m\n" "$INSTALL_DIR"
        exit 0
    fi
    if ! command -v curl >/dev/null 2>&1; then
        printf "\033[0;31m✗ Error: curl is required to install gltfpack\033[0m\n"
        exit 1
    fi
    if ! command -v unzip >/dev/null 2>&1; then
        printf "\033[0;31m✗ Error: unzip is required to install gltfpack\033[0m\n"
        exit 1
    fi
    case "$(uname -s)" in
        Darwin)
            if [ "$(uname -m)" = "arm64" ]; then
                ASSET="gltfpack-macos.zip"
            else
                ASSET="gltfpack-macos-intel.zip"
            fi
            BINARY="gltfpack"
            ;;
        Linux)
            ASSET="gltfpack-ubuntu.zip"
            BINARY="gltfpack"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            ASSET="gltfpack-windows.zip"
            BINARY="gltfpack.exe"
            ;;
        *)
            printf "\033[0;31m✗ Error: unsupported platform for gltfpack: %s\033[0m\n" "$(uname -s)"
            exit 1
            ;;
    esac
    printf "Installing gltfpack %s (%s)...\n" "$GLTFPACK_VERSION" "$ASSET"
    WORK_DIR="$(mktemp -d)"
    trap 'rm -rf "$WORK_DIR"' EXIT
    curl -fsSL -o "$WORK_DIR/$ASSET" \
        "https://github.com/zeux/meshoptimizer/releases/download/v$GLTFPACK_VERSION/$ASSET"
    unzip -q "$WORK_DIR/$ASSET" -d "$WORK_DIR"
    if [ ! -f "$WORK_DIR/$BINARY" ]; then
        printf "\033[0;31m✗ Error: %s not found in downloaded archive\033[0m\n" "$BINARY"
        exit 1
    fi
    mkdir -p "$INSTALL_DIR"
    install -m 0755 "$WORK_DIR/$BINARY" "$INSTALL_DIR/$BINARY"
    if ! command -v "$BINARY" >/dev/null 2>&1; then
        printf "  Note: add %s to your PATH to invoke gltfpack directly.\n" "$INSTALL_DIR"
    fi
    printf "\033[0;32m✓ gltfpack %s installed to %s\033[0m\n" "$GLTFPACK_VERSION" "$INSTALL_DIR"

# Install the DirectX Shader Compiler (HLSL -> SPIR-V; the project's only
# shader path). macOS has no official release binaries: DXC ships with the
# LunarG Vulkan SDK there and is only verified. Linux release binaries are
# x86_64-only.
[private]
_install-dxc:
    #!/usr/bin/env bash
    set -euo pipefail
    DXC_TAG="v1.9.2602.24"
    DXC_LINUX_ASSET="linux_dxc_2026_05_26.x86_64.tar.gz"
    INSTALL_ROOT="$HOME/.local"
    if command -v dxc >/dev/null 2>&1; then
        printf "\033[0;32m✓ dxc is installed (%s)\033[0m\n" "$(command -v dxc)"
        exit 0
    fi
    case "$(uname -s)" in
        Darwin)
            printf "\033[0;31m✗ Error: dxc not found. Install the LunarG Vulkan SDK: https://vulkan.lunarg.com/sdk/home\033[0m\n"
            exit 1
            ;;
        Linux)
            if [ "$(uname -m)" != "x86_64" ]; then
                printf "\033[0;31m✗ Error: official DXC Linux binaries are x86_64-only (this is %s)\033[0m\n" "$(uname -m)"
                printf "  Build DXC from source or use an x86_64 environment.\n"
                exit 1
            fi
            printf "Installing dxc %s...\n" "$DXC_TAG"
            WORK_DIR="$(mktemp -d)"
            trap 'rm -rf "$WORK_DIR"' EXIT
            curl -fsSL -o "$WORK_DIR/dxc.tar.gz" \
                "https://github.com/microsoft/DirectXShaderCompiler/releases/download/$DXC_TAG/$DXC_LINUX_ASSET"
            mkdir -p "$INSTALL_ROOT/opt/dxc"
            tar -xzf "$WORK_DIR/dxc.tar.gz" -C "$INSTALL_ROOT/opt/dxc"
            if [ ! -f "$INSTALL_ROOT/opt/dxc/bin/dxc" ]; then
                printf "\033[0;31m✗ Error: bin/dxc not found in DXC archive\033[0m\n"
                exit 1
            fi
            chmod +x "$INSTALL_ROOT/opt/dxc/bin/dxc"
            mkdir -p "$INSTALL_ROOT/bin"
            printf '%s\n' '#!/bin/sh' \
                'exec env LD_LIBRARY_PATH="$HOME/.local/opt/dxc/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "$HOME/.local/opt/dxc/bin/dxc" "$@"' \
                > "$INSTALL_ROOT/bin/dxc"
            chmod +x "$INSTALL_ROOT/bin/dxc"
            printf "\033[0;32m✓ dxc %s installed to %s\033[0m\n" "$DXC_TAG" "$INSTALL_ROOT/bin/dxc"
            ;;
        *)
            printf "\033[0;31m✗ Error: automatic dxc install is not supported on %s\033[0m\n" "$(uname -s)"
            printf "  Install DXC from https://github.com/microsoft/DirectXShaderCompiler/releases\n"
            exit 1
            ;;
    esac

# Install the KTX-Software CLI tools (toktx, ktx) for the texture pipeline.
# Pinned to the Conan ktx library version so CLI output stays loadable.
[private]
_install-ktx-tools:
    #!/usr/bin/env bash
    set -euo pipefail
    KTX_VERSION="4.4.2"
    INSTALL_ROOT="$HOME/.local"
    if command -v toktx >/dev/null 2>&1; then
        printf "\033[0;32m✓ toktx is installed (%s)\033[0m\n" "$(command -v toktx)"
        exit 0
    fi
    if [ -x "$INSTALL_ROOT/bin/toktx" ]; then
        printf "\033[0;32m✓ toktx is installed in %s/bin\033[0m\n" "$INSTALL_ROOT"
        exit 0
    fi
    WORK_DIR="$(mktemp -d)"
    trap 'rm -rf "$WORK_DIR"' EXIT
    case "$(uname -s)" in
        Darwin)
            ASSET="KTX-Software-$KTX_VERSION-Darwin-$(uname -m).pkg"
            printf "Installing KTX tools %s (%s)...\n" "$KTX_VERSION" "$ASSET"
            curl -fsSL -o "$WORK_DIR/ktx.pkg" \
                "https://github.com/KhronosGroup/KTX-Software/releases/download/v$KTX_VERSION/$ASSET"
            # Expand the pkg without sudo. It is a distribution of
            # sub-packages: tools binaries and the library live in separate
            # Payload trees, each mirroring /usr/local.
            pkgutil --expand-full "$WORK_DIR/ktx.pkg" "$WORK_DIR/expanded"
            TOKTX_PATH="$(find "$WORK_DIR/expanded" -type f -path '*/Payload/usr/local/bin/toktx' | head -1)"
            if [ -z "$TOKTX_PATH" ]; then
                printf "\033[0;31m✗ Error: toktx not found in KTX pkg payloads\033[0m\n"
                exit 1
            fi
            mkdir -p "$INSTALL_ROOT/opt/ktx/bin" "$INSTALL_ROOT/opt/ktx/lib" "$INSTALL_ROOT/bin"
            cp -R "$(dirname "$TOKTX_PATH")/." "$INSTALL_ROOT/opt/ktx/bin/"
            find "$WORK_DIR/expanded" -type d -path '*/Payload/usr/local/lib' | while IFS= read -r libdir; do
                cp -R "$libdir/." "$INSTALL_ROOT/opt/ktx/lib/"
            done
            for tool in toktx ktx ktxinfo ktx2check ktx2ktx2 ktxsc; do
                if [ -f "$INSTALL_ROOT/opt/ktx/bin/$tool" ]; then
                    chmod +x "$INSTALL_ROOT/opt/ktx/bin/$tool"
                    printf '%s\n' '#!/bin/sh' \
                        "exec env DYLD_LIBRARY_PATH=\"\$HOME/.local/opt/ktx/lib\${DYLD_LIBRARY_PATH:+:\$DYLD_LIBRARY_PATH}\" \"\$HOME/.local/opt/ktx/bin/$tool\" \"\$@\"" \
                        > "$INSTALL_ROOT/bin/$tool"
                    chmod +x "$INSTALL_ROOT/bin/$tool"
                fi
            done
            ;;
        Linux)
            ASSET="KTX-Software-$KTX_VERSION-Linux-$(uname -m).tar.bz2"
            printf "Installing KTX tools %s (%s)...\n" "$KTX_VERSION" "$ASSET"
            curl -fsSL -o "$WORK_DIR/ktx.tar.bz2" \
                "https://github.com/KhronosGroup/KTX-Software/releases/download/v$KTX_VERSION/$ASSET"
            mkdir -p "$INSTALL_ROOT/opt/ktx"
            tar -xjf "$WORK_DIR/ktx.tar.bz2" -C "$INSTALL_ROOT/opt/ktx" --strip-components=1
            if [ ! -f "$INSTALL_ROOT/opt/ktx/bin/toktx" ]; then
                printf "\033[0;31m✗ Error: bin/toktx not found in KTX archive\033[0m\n"
                exit 1
            fi
            mkdir -p "$INSTALL_ROOT/bin"
            for tool in toktx ktx ktxinfo ktx2check ktx2ktx2 ktxsc; do
                if [ -f "$INSTALL_ROOT/opt/ktx/bin/$tool" ]; then
                    chmod +x "$INSTALL_ROOT/opt/ktx/bin/$tool"
                    printf '%s\n' '#!/bin/sh' \
                        "exec env LD_LIBRARY_PATH=\"\$HOME/.local/opt/ktx/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}\" \"\$HOME/.local/opt/ktx/bin/$tool\" \"\$@\"" \
                        > "$INSTALL_ROOT/bin/$tool"
                    chmod +x "$INSTALL_ROOT/bin/$tool"
                fi
            done
            ;;
        *)
            printf "\033[0;31m✗ Error: automatic KTX tools install is not supported on %s\033[0m\n" "$(uname -s)"
            printf "  Install from https://github.com/KhronosGroup/KTX-Software/releases\n"
            exit 1
            ;;
    esac
    if ! "$INSTALL_ROOT/bin/toktx" --version >/dev/null 2>&1; then
        printf "\033[0;31m✗ Error: installed toktx does not run\033[0m\n"
        exit 1
    fi
    printf "\033[0;32m✓ KTX tools %s installed to %s/bin (toktx %s)\033[0m\n" \
        "$KTX_VERSION" "$INSTALL_ROOT" "$("$INSTALL_ROOT/bin/toktx" --version 2>&1 | head -1)"

# Check prerequisites
check:
    @echo ""
    @if ! command -v cmake >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: cmake is not installed\033[0m\n"; \
        printf "  Install with: brew install cmake\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ cmake is installed\033[0m\n"
    @just _llvm-bin >/dev/null
    @printf "\033[0;32m✓ LLVM/Clang is installed\033[0m\n"
    @if ! command -v clang-format >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: clang-format is not installed\033[0m\n"; \
        printf "  Install with: brew install clang-format\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ clang-format is installed\033[0m\n"
    @if ! command -v clang-tidy >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: clang-tidy is not installed\033[0m\n"; \
        printf "  Install with: brew install llvm\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ clang-tidy is installed\033[0m\n"
    @if ! command -v cppcheck >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: cppcheck is not installed\033[0m\n"; \
        printf "  Install with: brew install cppcheck\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ cppcheck is installed\033[0m\n"
    @if ! command -v flawfinder >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: flawfinder is not installed\033[0m\n"; \
        printf "  Install with: brew install flawfinder\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ flawfinder is installed\033[0m\n"
    @if ! command -v codespell >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: codespell is not installed\033[0m\n"; \
        printf "  Install with: brew install codespell\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ codespell is installed\033[0m\n"
    @if ! command -v semgrep >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: semgrep is not installed\033[0m\n"; \
        printf "  Install with: brew install semgrep\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ semgrep is installed\033[0m\n"
    @if ! command -v lcov >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: lcov is not installed\033[0m\n"; \
        printf "  Install with: brew install lcov\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ lcov is installed\033[0m\n"
    @if ! command -v infer >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: infer is not installed\033[0m\n"; \
        printf "  Install from: https://github.com/facebook/infer\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ infer is installed\033[0m\n"
    @if ! command -v iwyu_tool >/dev/null 2>&1 && ! command -v iwyu_tool.py >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: iwyu_tool is not installed\033[0m\n"; \
        printf "  Install with: brew install include-what-you-use\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ iwyu_tool is installed\033[0m\n"
    @if ! command -v conan >/dev/null 2>&1; then \
        printf "\033[0;31m✗ Error: conan is not installed\033[0m\n"; \
        printf "  Install with: brew install conan\n"; \
        echo ""; \
        exit 1; \
    fi
    @printf "\033[0;32m✓ conan is installed\033[0m\n"
