        printf "\033[0;31m✗ Error: dxc is not installed (HLSL shader compiler)\033[0m\n"; \
        printf "  Install the LunarG Vulkan SDK: https://vulkan.lunarg.com/sdk/home\n"; \
        echo ""; \
        exit 1; \
    fi
    @if [ "$(uname -s)" = "Darwin" ]; then printf "\033[0;32m✓ dxc is installed\033[0m\n"; fi
    @echo ""

# Initialize the development environment
init: check
    @echo ""
    @printf "\033[0;34m=== Initializing Development Environment ===\033[0m\n"
    @if ! git rev-parse --git-dir >/dev/null 2>&1; then printf "Initializing git repository...\n" && git init -q; fi
    @mkdir -p reports/coverage
    @mkdir -p reports/security
    @if [ ! -f "$HOME/.conan2/profiles/default" ]; then \
        bin="$(just _llvm-bin)" && CC="$bin/clang" CXX="$bin/clang++" conan profile detect; \
    fi
    @echo "Installing Conan dependencies (Debug)..."
    @bin="$(just _llvm-bin)" && CC="$bin/clang" CXX="$bin/clang++" \
        CMAKE_POLICY_VERSION_MINIMUM=3.5 conan install . \
        --output-folder=build/conan/Debug -s build_type=Debug \
        -s compiler.cppstd={{cpp_standard}} -s "ktx/*:compiler.cppstd=17" \
        -c tools.cmake.cmaketoolchain:generator=Ninja --build=missing
    @echo "Installing Conan dependencies (Release)..."
    @bin="$(just _llvm-bin)" && CC="$bin/clang" CXX="$bin/clang++" \
        CMAKE_POLICY_VERSION_MINIMUM=3.5 conan install . \
        --output-folder=build/conan/Release -s build_type=Release \
        -s compiler.cppstd={{cpp_standard}} -s "ktx/*:compiler.cppstd=17" \
        -c tools.cmake.cmaketoolchain:generator=Ninja --build=missing
    @just _install-gltfpack
    @just _install-dxc
    @just _install-ktx-tools
    @echo "Configuring CMake debug preset..."
    @bin="$(just _llvm-bin)" && CC="$bin/clang" CXX="$bin/clang++" cmake --preset debug
    @echo "Building project..."
    @cmake --build --preset debug
    @printf "Activating git hooks...\n"
    @if [ ! -f ".git/hooks/pre-commit" ]; then \
        printf "\033[0;31m✗ Error: .git/hooks/pre-commit is missing\033[0m\n"; \
        printf "  Re-apply the template or restore the generated pre-commit hook.\n"; \
        echo ""; \
        exit 1; \
    fi
    @chmod +x .git/hooks/pre-commit
    @printf "\033[0;32m✓ Development environment ready\033[0m\n"
    @echo ""

# Remove build artifacts and caches
destroy:
    @echo ""
    @printf "\033[0;34m=== Destroying Build Artifacts ===\033[0m\n"
    @rm -rf build/ reports/
    @printf "\033[0;32m✓ Build artifacts removed\033[0m\n"
    @echo ""

# Run the main application
run:
    @echo ""
    @printf "\033[0;34m=== Running Application ===\033[0m\n"
    @cmake --build --preset debug
    @./build/debug/{{project_name}}
    @echo ""

# Run the Vulkan cube demo (pass e.g. `--auto-quit 5` for a timed smoke run)
demo *args:
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    printf "\033[0;34m=== Running Vulkan Cube Demo ===\033[0m\n"
    cmake --build --preset debug
    # Put the Conan-provided shared libraries (notably the Vulkan loader) on
    # the dynamic linker path so SDL can locate them at runtime.
    source build/conan/Debug/conanrun.sh
    if [ "$(uname -s)" = "Darwin" ]; then
        MOLTENVK_ICD="$(brew --prefix molten-vk)/etc/vulkan/icd.d/MoltenVK_icd.json"
        if [ ! -f "$MOLTENVK_ICD" ]; then
            printf "\033[0;31m✗ Error: MoltenVK ICD manifest not found at %s\033[0m\n" "$MOLTENVK_ICD"
            printf "  Install with: brew install molten-vk\n"
            exit 1
        fi
        export VK_ICD_FILENAMES="$MOLTENVK_ICD"
        export VK_DRIVER_FILES="$MOLTENVK_ICD"
        # Expose the LunarG SDK's validation layers (debug builds enable them).
        SDK_LAYER_DIR="/usr/local/share/vulkan/explicit_layer.d"
        if [ -f "$SDK_LAYER_DIR/VkLayer_khronos_validation.json" ]; then
            export VK_LAYER_PATH="$SDK_LAYER_DIR"
        fi
    fi
    ./build/debug/{{project_name}}_demo {% raw %}{{args}}{% endraw %}
    printf "\033[0;32m✓ Demo exited cleanly\033[0m\n"
    echo ""

# Auto-fix code formatting with clang-format
code-format:
    #!/usr/bin/env bash
    set -e
    echo ""
    printf "\033[0;34m=== Formatting Code ===\033[0m\n"
    FILES=$(find src/ include/ tests/ -type f \( -name "*.cpp" -o -name "*.hpp" \) 2>/dev/null)
    if [ -n "$FILES" ]; then
        echo "$FILES" | xargs clang-format -i
    fi
    printf "\033[0;32m✓ Code formatted\033[0m\n"
    echo ""

# Run clang-tidy static analysis
code-style:
    #!/usr/bin/env bash
    set -e
    # CPATH directories behave like -I (searched before Conan's -isystem and
    # not treated as system headers); Apple's git exports
    # CPATH=/usr/local/include inside hooks, shadowing Conan dependencies.
    unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH
    echo ""
    printf "\033[0;34m=== Checking Code Style ===\033[0m\n"
    EXTRA_ARGS=""
    if [ "$(uname)" = "Darwin" ] && command -v xcrun >/dev/null 2>&1; then
        if ! SDKROOT=$(xcrun --show-sdk-path 2>/dev/null); then
            printf "\033[0;31m✗ xcrun found but SDK path lookup failed. Install Xcode CLI tools or run 'xcode-select --install'\033[0m\n" >&2
            exit 1
        fi
        EXTRA_ARGS="--extra-arg=--sysroot=$SDKROOT"
    fi
    FILES=$(find src/ -type f -name "*.cpp" 2>/dev/null)
    if [ -n "$FILES" ]; then
        echo "$FILES" | xargs clang-tidy --quiet -p build/debug $EXTRA_ARGS
    fi
    printf "\033[0;32m✓ Style checks passed\033[0m\n"
    echo ""

# Run cppcheck static analysis
code-typecheck:
    @echo ""
    @printf "\033[0;34m=== Running Static Analysis (cppcheck) ===\033[0m\n"
    @cppcheck --enable=all --error-exitcode=1 --suppress=missingIncludeSystem --std=c++{{cpp_standard}} -I include/ src/
    @printf "\033[0;32m✓ Static analysis passed\033[0m\n"
    @echo ""

# Run security checks with flawfinder
code-security:
    @echo ""
    @printf "\033[0;34m=== Running Security Checks ===\033[0m\n"
    @mkdir -p reports/security
    @flawfinder --minlevel=1 src/ include/ > reports/security/flawfinder.txt 2>&1
    @flawfinder --minlevel=1 --error-level=1 src/ include/
    @printf "\033[0;32m✓ Security checks passed\033[0m\n"
    @echo ""

# Run Infer static analysis (null dereference, memory leaks, buffer overruns)
code-infer:
    @echo ""
    @printf "\033[0;34m=== Running Infer Static Analysis ===\033[0m\n"
    @infer run --fail-on-issue --skip-analysis-in-path ".*\.conan2.*" \
        --compilation-database build/debug/compile_commands.json
    @printf "\033[0;32m✓ Infer analysis passed\033[0m\n"
    @echo ""

# Check include hygiene with IWYU
code-deptry:
    #!/usr/bin/env bash
    set -e
    # See code-style: keep ambient CPATH-style variables away from
    # clang-based tooling so Conan includes cannot be shadowed.
    unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH
    echo ""
    printf "\033[0;34m=== Checking Include Hygiene (IWYU) ===\033[0m\n"
    IWYU_OUTPUT=""
    IWYU_CMD=""
    if command -v iwyu_tool >/dev/null 2>&1; then
        IWYU_CMD="iwyu_tool"
    elif command -v iwyu_tool.py >/dev/null 2>&1; then
        IWYU_CMD="iwyu_tool.py"
    else
        printf "\033[0;31m✗ iwyu_tool is not installed\033[0m\n"
        printf "  Install with: brew install include-what-you-use\n"
        exit 1
    fi
    # Only check project source files (not fetched dependencies in build/).
    SOURCES=$(find src/ -type f -name "*.cpp" 2>/dev/null)
    if [ -z "$SOURCES" ]; then
        printf "\033[0;31m✗ No source files found in src/\033[0m\n"
        exit 1
    fi
    # IWYU exits non-zero even when code is clean; capture output and
    # let the grep check below decide pass/fail. The mapping file teaches
    # IWYU the public spellings for glm's private implementation headers
    # and the macOS SDK-private <_stdio.h>.
    if ! IWYU_OUTPUT="$($IWYU_CMD -p build/debug $SOURCES -- -Xiwyu --no_fwd_decls \
        -Xiwyu --mapping_file="$PWD/config/iwyu/mappings.imp" 2>&1)"; then
        :
    fi
    printf "%s\n" "$IWYU_OUTPUT"
    # <ios> is the one known IWYU/clang-tidy conflict: include-cleaner
    # requires it for std::ios/std::streamsize while IWYU's libc++ mapping
    # credits <fstream> and wants it removed. include-cleaner wins; this is
    # the single named exception to IWYU's removal check.
    if printf "%s\n" "$IWYU_OUTPUT" | grep '^- #include' | grep -v '^- #include <ios>' | grep -q .; then
        printf "\033[0;31m✗ Unnecessary includes found (see IWYU output above)\033[0m\n"
        exit 1
    fi
    printf "\033[0;32m✓ Include hygiene check completed\033[0m\n"
    echo ""

# Check spelling in code and documentation
code-spell:
    @echo ""
    @printf "\033[0;34m=== Checking Spelling ===\033[0m\n"
    @codespell src include tests scripts *.md
    @printf "\033[0;32m✓ Spelling checks passed\033[0m\n"
    @echo ""

# Run Semgrep static analysis
code-semgrep:
    @echo ""
    @printf "\033[0;34m=== Running Semgrep Static Analysis ===\033[0m\n"
    @semgrep --config config/semgrep/ --error --no-git-ignore src/ include/ tests/ scripts/
    @printf "\033[0;32m✓ Semgrep checks passed\033[0m\n"
    @echo ""

# Run tests with sanitizers (AddressSanitizer + UndefinedBehaviorSanitizer)
code-sanitize:
    @echo ""
    @printf "\033[0;34m=== Running Sanitizer Tests ===\033[0m\n"
    @bin="$(just _llvm-bin)" && CC="$bin/clang" CXX="$bin/clang++" cmake --preset sanitize
    @cmake --build --preset sanitize
    @ctest --preset sanitize
    @printf "\033[0;32m✓ Sanitizer tests passed\033[0m\n"
