import wartremover.Wart

ThisBuild / organization      := "{{group_id}}"
ThisBuild / version           := "0.1.0"
ThisBuild / scalaVersion      := "3.3.8"
ThisBuild / semanticdbEnabled := true

lazy val app = (project in file("."))
  .settings(
    name                 := "{{project_slug}}",
    Compile / mainClass  := Some("{{package_name}}.cli.Main"),
    Compile / run / fork := true,
    scalacOptions ++= Seq(
      "-Werror",
      "-Wall",
      "-deprecation",
      "-feature",
      "-unchecked",
      "-Wunused:all",
      "-Wvalue-discard",
      "-Wnonunit-statement",
      "-Ysafe-init",
      "-java-output-version:{{jvm_target}}",
      "-language:strictEquality"
    ),
    libraryDependencies ++= Seq(
      "org.scalameta"       %% "munit"     % "1.3.5"  % Test,
      "com.tngtech.archunit" % "archunit"  % "1.5.0"  % Test,
      "org.slf4j"            % "slf4j-nop" % "2.0.18" % Test
    ),
    testFrameworks += new TestFramework("munit.Framework"),
    Compile / wartremoverErrors ++= Seq(
      Wart.AsInstanceOf,
      Wart.DefaultArguments,
      Wart.IsInstanceOf,
      Wart.Null,
      Wart.OptionPartial,
      Wart.Return,
      Wart.Throw,
      Wart.TryPartial,
      Wart.Var
    ),
    Test / wartremoverErrors ++= Seq(
      Wart.AsInstanceOf,
      Wart.DefaultArguments,
      Wart.IsInstanceOf,
      Wart.Null,
      Wart.OptionPartial,
      Wart.Return,
      Wart.Throw,
      Wart.TryPartial,
      Wart.Var
    ),
    scalafixDependencies += "{{group_id}}" % "{{project_slug}}-scalafix-rules_2.13" % "0.1.0-SNAPSHOT",
    // sbt-findsecbugs injects ASM into Compile for its own bytecode analysis.
    // These are build-tool internals, not application dependencies.
    unusedCompileDependenciesFilter ~= (_ - moduleFilter("org.ow2.asm", "asm")),
    unusedCompileDependenciesFilter ~= (_ - moduleFilter("org.ow2.asm", "asm-analysis")),
    unusedCompileDependenciesFilter ~= (_ - moduleFilter("org.ow2.asm", "asm-commons")),
    unusedCompileDependenciesFilter ~= (_ - moduleFilter("org.ow2.asm", "asm-tree")),
    unusedCompileDependenciesFilter ~= (_ - moduleFilter("org.ow2.asm", "asm-util")),
    coverageFailOnMinimum      := true,
    coverageMinimumStmtTotal   := {{coverage_threshold}},
    coverageMinimumBranchTotal := {{coverage_threshold}},
    coverageHighlighting       := true,
    Test / parallelExecution   := false
  )
