{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/switftmac/performance-baseline.schema.json",
  "title": "switftmac reviewed performance baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "iterations", "regressionPercent", "runner", "tests"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "iterations": { "type": "integer", "minimum": 1 },
    "regressionPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "deviceName", "configurationId", "configurationName"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1 },
        "deviceName": { "type": "string", "minLength": 1 },
        "configurationId": { "type": "string", "minLength": 1 },
        "configurationName": { "type": "string", "minLength": 1 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testIdentifier", "metrics"],
        "properties": {
          "testIdentifier": { "type": "string", "minLength": 1 },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "displayName", "unitOfMeasurement", "average"],
              "properties": {
                "identifier": { "type": "string", "minLength": 1 },
                "displayName": { "type": "string", "minLength": 1 },
                "unitOfMeasurement": { "type": "string", "minLength": 1 },
                "average": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
