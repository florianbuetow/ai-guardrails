ci:
    @echo ""
    @printf "\033[34mRunning all mandatory CI checks\033[0m\n"
    @just check && just build && just code-style && just code-analyze && just code-architecture && just code-semgrep && just code-security && just code-secrets && just code-shell && just code-spell && just code-dependencies && just code-docs && just code-package && just test && just test-ui && just test-accessibility && just test-snapshots && just test-coverage && just test-sanitize && just test-performance && printf "\033[32mAll CI checks passed\033[0m\n" || { printf "\033[31mCI failed\033[0m\n"; exit 1; }
    @echo ""

ci-quiet:
    @echo ""
    @printf "\033[34mRunning CI Checks (Quiet Mode)\033[0m\n"
    @mkdir -p build/logs
    @just ci > build/logs/ci.log 2>&1 && printf "\033[32mAll CI checks passed\033[0m\n" || { cat build/logs/ci.log; printf "\033[31mCI failed\033[0m\n"; exit 1; }
    @echo ""

