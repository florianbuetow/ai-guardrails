set shell := ["bash", "-euo", "pipefail", "-c"]

_default:
    @just help

help:
    @echo ""
    @printf "\033[34mNative macOS development\033[0m\n"
    @printf "  %-24s %s\n" "bootstrap-check" "Verify supported macOS and exact Xcode"
    @printf "  %-24s %s\n" "init" "Install and configure every required tool"
    @printf "  %-24s %s\n" "check" "Verify installed tool versions"
    @printf "  %-24s %s\n" "build" "Build native application"
    @printf "  %-24s %s\n" "run" "Launch verified application bundle"
    @printf "  %-24s %s\n" "code-format" "Format Swift source"
    @printf "  %-24s %s\n" "code-style" "Check Swift formatting and lint"
    @printf "  %-24s %s\n" "code-analyze" "Run type-aware SwiftLint analysis"
    @printf "  %-24s %s\n" "code-architecture" "Enforce Swift policies and module boundaries"
    @printf "  %-24s %s\n" "code-semgrep" "Check forbidden execution and shell policies"
    @printf "  %-24s %s\n" "code-security" "Check application security patterns"
    @printf "  %-24s %s\n" "code-secrets" "Scan owned files for secrets"
    @printf "  %-24s %s\n" "code-shell" "Check shell automation"
    @printf "  %-24s %s\n" "code-spell" "Check spelling"
    @printf "  %-24s %s\n" "code-dependencies" "Verify dependency locks and scan advisories"
    @printf "  %-24s %s\n" "code-docs" "Build documentation with strict diagnostics"
    @printf "  %-24s %s\n" "code-package" "Validate native application bundle"
    @printf "  %-24s %s\n" "test" "Run unit, integration and property tests"
    @printf "  %-24s %s\n" "test-ui" "Run native application workflow tests"
    @printf "  %-24s %s\n" "test-accessibility" "Audit application accessibility"
    @printf "  %-24s %s\n" "test-snapshots" "Compare reviewed visual snapshots"
    @printf "  %-24s %s\n" "test-coverage" "Enforce first-party line coverage"
    @printf "  %-24s %s\n" "test-sanitize" "Run separate ASan and TSan suites"
    @printf "  %-24s %s\n" "test-performance" "Measure application launch performance"
    @printf "  %-24s %s\n" "performance-baseline" "Explicitly recalibrate performance on this runner"
    @printf "  %-24s %s\n" "debug" "Debug native executable with LLDB"
    @printf "  %-24s %s\n" "profile" "Record a Time Profiler trace"
    @printf "  %-24s %s\n" "ci" "Run all mandatory checks fail-fast"
    @printf "  %-24s %s\n" "ci-quiet" "Run CI with retained logs"
    @printf "  %-24s %s\n" "memory PID" "Inspect a running application with vmmap/leaks"
    @printf "  %-24s %s\n" "coverage-export PROFILE BINARY" "Export an instrumented binary's LLVM coverage"
    @printf "  %-24s %s\n" "release" "Sign and notarize using supplied credentials"
    @printf "\033[32mhelp completed successfully\033[0m\n"
    @echo ""

